# Скопируйте эти переменные в настройки хостинга (Railway: вкладка Variables)
BOT_TOKEN=токен_от_BotFather
DB_PATH=/data/finance.db
PUBLIC_URL=https://адрес-вашего-приложения.up.railway.app
TIMEZONE=Europe/Moscow
# Ваш Telegram ID, чтобы ботом мог пользоваться только вы
ALLOWED_USERS=YOUR_TELEGRAM_ID
# Необязательно: ключ Claude API (нужна строка anthropic в requirements.txt)
# ANTHROPIC_API_KEY=
