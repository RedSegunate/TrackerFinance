# Copy this to .env for local runs. Set the same values in Render Environment.
BOT_TOKEN=your_telegram_bot_token
# Supabase Dashboard -> Connect -> Session pooler. Leave unset for local SQLite.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DB_SCHEMA=tracker_finance
# Used only when DATABASE_URL is not set.
DB_PATH=finance.db
PORT=8080
PUBLIC_URL=
TIMEZONE=Europe/Moscow
# Leave ALLOWED_USERS empty for a public multi-user bot. Set IDs to restrict access.
ALLOWED_USERS=
# Admin IDs stay allowed even when ALLOWED_USERS is restricted.
ADMIN_USERS=123456789
# AI is disabled by default; enable only when desired and a key is configured.
AI_ENABLED=0
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
APP_DEV=0
