# Copy this to .env for the primary Python bot, or set these in Railway.
BOT_TOKEN=your_telegram_bot_token
DB_PATH=finance.db
PORT=8080
PUBLIC_URL=
TIMEZONE=Europe/Moscow
# Comma-separated Telegram IDs. Set this for a private bot.
ALLOWED_USERS=123456789
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
APP_DEV=0
